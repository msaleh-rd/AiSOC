# AiSOC Environment Variables
# Copy this file to .env and fill in your values
#
# â•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—
# â•‘ REQUIRED FOR LOCAL DEV â€” set these three before `aisoc serve`:             â•‘
# â•‘                                                                            â•‘
# â•‘   1. OPENAI_API_KEY        your LLM provider API key (see "AI / LLM")      â•‘
# â•‘   2. POSTGRES_PASSWORD     dev Postgres password (the default below works  â•‘
# â•‘                            out of the box; change for shared envs)         â•‘
# â•‘   3. AISOC_CREDENTIAL_KEY  Fernet key for the connector credential vault.  â•‘
# â•‘                            REQUIRED. Generate one (see below) â€” there is   â•‘
# â•‘                            no default; the app will fail to start without  â•‘
# â•‘                            it. NEVER reuse a key from anywhere public.     â•‘
# â•‘                                                                            â•‘
# â•‘ Everything else has sensible defaults for `docker compose -f               â•‘
# â•‘ infra/compose/docker-compose.dev.yml up -d`.                               â•‘
# â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€â”€ Image Pinning â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Tag pulled by every `image: ghcr.io/beenuar/aisoc-*:${AISOC_VERSION:-latest}`
# in docker-compose.yml. With `pull_policy: missing`, Docker will pull this tag
# on first boot and skip the local build (~90 s vs ~15 min). Pin to a release
# tag (e.g. v7.2.0) for reproducible deploys; leave as `latest` to track main.
AISOC_VERSION=latest

# â”€â”€â”€ Core Configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=iMPVQYnMo57JCAXiA-pDY1lZRiXJqRK_wFmroQHOAl3Qi7y-wMtsO3FrD5q8-I9a

# Shared HS256 secret used ONLY for short-lived realtime WS/SSE tickets
# (Issue #239). The API mints tickets at `POST /api/v1/realtime/ticket` and the
# Node realtime service (`services/realtime`) verifies them on every WebSocket
# upgrade and SSE request â€” both sides MUST read the same value. This is
# intentionally separate from SECRET_KEY so the realtime edge can be rotated
# independently and a leaked ticket can never forge a full API session.
#
# Leave blank in development: both services fall back to a well-known dev secret
# so docker-compose "just works". In production you MUST set a real value â€”
# the ticket endpoint fails closed (503) and the realtime service rejects every
# connection until this is wired. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AISOC_REALTIME_JWT_SECRET=0fcc9391f13196dd4128b349325b72f2048070b0f81b5271bf22ce309648072d
# Time-to-live (seconds) for minted realtime tickets. Kept short so a leaked
# ticket is only briefly useful; the frontend re-mints on every (re)connect.
# Clamped to a 60s ceiling by the ticket endpoint regardless of this value.
AISOC_REALTIME_TICKET_TTL_SECONDS=60

# Application-layer encryption key for connector credentials and other
# secret payloads stored in Postgres. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED. There is no built-in default â€” generate your own key with the
# command above and paste it here. Treat this value like a database password:
# never commit it, never reuse it across environments, never share it.
AISOC_CREDENTIAL_KEY=MSlPLD0VYqeDB80THPly13o-qlpJHLFWsuw9itmabKU=
# Comma-separated list of previous credential keys to support zero-downtime
# rotation. Leave blank unless you are mid-rotation.
AISOC_CREDENTIAL_KEY_ROTATION_FROM=4FUFRjrcIq1ejLVATIVaFkKYtmkfhRnwnUTXdkwyqyk=

# Internal URL the API uses to reach the connectors microservice for
# catalog lookups and "Test connection" actions in the click-and-connect
# wizard. ``http://connectors:8087`` is correct for docker-compose;
# use ``http://localhost:8088`` when running the API on the host while
# connectors is exposed via the docker-compose port forward.
CONNECTORS_SERVICE_URL=http://connectors:8087
CONNECTORS_SERVICE_TIMEOUT_SECONDS=15

# â”€â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# POSTGRES_PASSWORD is the dev password for the bundled Postgres container.
# `docker-compose.yml` and the API both interpolate this value, so changing it
# here is enough to rotate the dev password across the stack.
POSTGRES_PASSWORD=aisoc_dev_secret
DATABASE_URL=postgresql+asyncpg://aisoc:${POSTGRES_PASSWORD}@localhost:5432/aisoc
REDIS_URL=redis://:redis_dev_secret@localhost:6380/0
CLICKHOUSE_URL=http://aisoc:clickhouse_dev_secret@localhost:8123/aisoc

# ─── Temporal.io durability overlay (optional) ──────────────────────────────
# Off by default. Set to 1 to route /investigate through the durable
# InvestigationWorkflow instead of the in-process LangGraph pipeline. Requires
# `docker compose --profile temporal up -d` (temporal server + agents-temporal-worker).
AISOC_AGENT_TEMPORAL_MODE=1

# â”€â”€â”€ Messaging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# â”€â”€â”€ Search â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333

# â”€â”€â”€ AI / LLM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Every aisoc-* alias in infra/litellm/config.yaml points at this one remote
# LM Studio / vLLM box (OpenAI-compatible API). Change the model served there
# and it's live everywhere (triage, recon, investigation, copilot, summary,
# report, NL) with no other edits.
LM_STUDIO_URL=http://10.7.75.103:1234/v1
LLM_MODEL=openai/gpt-oss-20b
# LM Studio ignores this value entirely; LiteLLM only needs it present.
LM_STUDIO_API_KEY=lm-studio
# Embedding-capable model for ATT&CK semantic search/RAG (aisoc-embed alias).
# Distinct from LLM_MODEL — must be an embedding model, not a chat model. Load
# it in LM Studio alongside LLM_MODEL. If you change this, also update
# AISOC_EMBEDDING_DIMENSIONS (services/agents) to match its native output size.
# MUST carry an explicit provider prefix (openai/...) — unlike chat completions,
# LiteLLM cannot infer a provider for embedding calls from api_base alone and
# fails with "LLM Provider NOT provided" without it.
EMBEDDING_MODEL=openai/text-embedding-nomic-embed-text-v1.5
ANTHROPIC_API_KEY=

# â”€â”€â”€ LLM gateway (LiteLLM) â€” issue #478 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Since #478 AiSOC asks for a logical task alias (aisoc-triage,
# aisoc-investigation, â€¦) for every live LLM call â€” there is no hardcoded default
# model. The alias â†’ real-model map lives in infra/litellm/config.yaml, so you
# swap local/hosted models there without changing AiSOC.
#
# Key that AiSOC (api + agents services) sends to authenticate to the gateway
# (also LiteLLM's own admin key). docker-compose.yml defaults each service's
# OPENAI_API_KEY to this value automatically, so leave OPENAI_API_KEY unset
# above — setting it here would only apply to the gateway path, not to LM
# Studio's own key (LM_STUDIO_API_KEY, above), which is a separate concern.
LITELLM_MASTER_KEY=sk-aisoc-YJuSxh_MLNcLzTnIPVdSftOI1RxE6ZDj
# In-network URL of the gateway (already set per-service in docker-compose.yml):
LLM_GATEWAY_URL=http://litellm:4000/v1
#
# docker-compose.yml now routes the api + agents services through the gateway
# by default (OPENAI_BASE_URL=http://litellm:4000/v1), so live LLM calls work
# out of the box against whatever infra/litellm/config.yaml points at above.
# To bypass the gateway and call a provider directly instead, set here:
#   OPENAI_BASE_URL=
#   OPENAI_API_KEY=<your provider key>
#   AISOC_MODEL_PIN_TRIAGE=gpt-4o-mini
#   AISOC_MODEL_PIN_INVESTIGATION=gpt-4o
# With neither configured, AiSOC uses its deterministic offline path.

